# Copy to .env. Nothing here is a secret: every value points at a container on a
# local bridge network that `down -v` destroys. Real credentials arrive with real
# deployment, and never through this file.

# --- Postgres ---------------------------------------------------------------
# Superuser, for migrations and psql. Services do NOT use this: each connects as
# its own role, which can only reach its own schema (infra/docker/postgres/init).
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/xclone

# Per-service connection strings. Host is `postgres` from inside the compose
# network, `localhost` from your shell.
IDENTITY_DATABASE_URL=postgres://identity_svc:identity_svc_dev@postgres:5432/xclone
GRAPH_DATABASE_URL=postgres://graph_svc:graph_svc_dev@postgres:5432/xclone
TWEET_DATABASE_URL=postgres://tweet_svc:tweet_svc_dev@postgres:5432/xclone
MEDIA_DATABASE_URL=postgres://media_svc:media_svc_dev@postgres:5432/xclone
NOTIFICATION_DATABASE_URL=postgres://notification_svc:notification_svc_dev@postgres:5432/xclone

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Kafka (Redpanda locally) -----------------------------------------------
# `redpanda:9092` inside the network; `localhost:9092` from the host. Two
# advertised listeners exist precisely so both are true.
KAFKA_BROKERS=redpanda:9092

# --- Identifiers ------------------------------------------------------------
# Ten bits of Snowflake node id: 0-1023, unique per RUNNING INSTANCE, not per
# service. Two replicas sharing a value do not fail or warn — they issue the
# same id to two different rows whenever both mint inside the same millisecond.
# A service whose value is missing, non-numeric or out of range refuses to boot.
#
# One value here is enough while services run one at a time on the host. In
# compose, each service gets its own from an allocation kept in compose.yml.
SNOWFLAKE_NODE_ID=1

# --- Observability ----------------------------------------------------------
# Everything ships to the collector, never to a backend directly.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# --- Deferred: Phase 6 (media) and Phase 8 (search) -------------------------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=xclone-media
OPENSEARCH_URL=http://opensearch:9200
