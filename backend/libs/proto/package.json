{
  "name": "@x-clone/proto",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/identity/v1 && cp src/identity/v1/identity.proto dist/identity/v1/identity.proto",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.13.4"
  },
  "devDependencies": {
    "@grpc/proto-loader": "0.8.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
